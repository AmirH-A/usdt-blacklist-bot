# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token

# Webhook URL (for production, e.g., https://your-domain.com)
# Leave empty for local development (uses polling mode)
WEBHOOK_URL=

# Webhook secret for verifying Telegram requests
WEBHOOK_SECRET=your_webhook_secret

# TronGrid API Key (optional but recommended for higher rate limits)
# Get one at: https://www.trongrid.io/
TRONGRID_API_KEY=

# Chainstack TRON gRPC (preferred live block source). HTTP getnowblock is the fallback.
CHAINSTACK_GRPC_HOST=tron-mainnet.core.chainstack.com
CHAINSTACK_GRPC_PORT=443
CHAINSTACK_API_TOKEN=
CHAINSTACK_API_TOKEN_FALLBACK=
USE_GRPC=true
BLOCK_POLL_INTERVAL=0.25

# Etherscan API Key (required for ETH event fallback)
# Get one at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Ethereum JSON-RPC for live block watching (Chainstack execution URL).
ETH_RPC_URL=https://ethereum-mainnet.core.chainstack.com/YOUR_KEY
ETH_RPC_URL_FALLBACK=
ETH_BLOCK_POLL_INTERVAL=0.25

# Chain toggles (both enabled by default)
ENABLE_TRON=true
ENABLE_ETH=true

# Postgres connection. This is the live store; the SQLite path below is only
# read by migrate_to_pg.py when importing an old blacklist_tracker.db.
# `docker compose up -d` starts the matching container (see docker-compose.yml).
FD_DB_PASSWORD=choose_a_password
DATABASE_URL=postgresql://fd:choose_a_password@127.0.0.1:5435/freeze_detector

# Legacy SQLite path, kept for the one-off migration only.
DB_PATH=blacklist_tracker.db

# --- Node endpoints --------------------------------------------------------
# Ordered, comma-separated list of nodes per chain; the first is primary and
# the rest are failover. Leave unset to use the CHAINSTACK_* / ETH_RPC_URL
# variables above, which is what an existing deployment does.
#
#   grpc://host:port?token=X   TRON gRPC, sends `x-token: X`
#   https://host?token=X       HTTP, sends `x-token: X`        (Chainstack REST)
#   https://host?api_key=X     HTTP, sends `TRON-PRO-API-KEY`  (TronGrid)
#   https://host?header=K:V    HTTP, sends a literal header    (escape hatch)
#   http://10.0.0.5:8090       HTTP, no auth                   (self-hosted node)
#
# TRON_NODES=grpc://tron-mainnet.core.chainstack.com:443?token=KEY,https://api.trongrid.io?api_key=KEY
# ETH_NODES=https://ethereum-mainnet.core.chainstack.com/KEY,http://10.0.0.6:8545
TRON_NODES=
ETH_NODES=

# --- Credential watchdog ---------------------------------------------------
# A dead or quota-exhausted RPC key does not raise: failover hides it and
# detection quietly degrades. These probe every configured endpoint and alert
# ADMIN_CHAT_ID when one needs rotating. Without ADMIN_CHAT_ID the alert is
# only logged.
ADMIN_CHAT_ID=
PROVIDER_PROBE_INTERVAL=300
PROVIDER_REMIND_HOURS=6

# --- Mempool watchers (optional) -------------------------------------------
# TRON mempool polling uses its own TronGrid key so it cannot spend the block
# watcher's quota; empty falls back to TRONGRID_API_KEY.
TRONGRID_MEMPOOL_API_KEY=
# ETH mempool: Alchemy websocket, off unless ENABLE_ETH_MEMPOOL=true.
ENABLE_ETH_MEMPOOL=false
ALCHEMY_API_KEY=
