# Environment for multisig_tracker.py (systemd unit multisig-tracker,
# EnvironmentFile=/root/zarin-freeze-detector/multisig_tracker.env).
# Copy to multisig_tracker.env; never commit the real file.
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
# Google Sheets logging; without MULTISIG_SHEET_ID it is disabled. The
# credentials file is a service-account JSON, kept out of git.
GOOGLE_SHEETS_CREDS_FILE=google_sheets_creds.json
MULTISIG_SHEET_ID=
# postgresql://user:password@host:5432/dbname
MULTISIG_DATABASE_URL=
